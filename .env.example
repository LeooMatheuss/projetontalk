# Copie para .env e ajuste. O arquivo .env é carregado automaticamente (exceto em NODE_ENV=test).
NODE_ENV=development
PORT=3000

# Obrigatória em produção. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Opcionais em development/test (padrões: localhost). Obrigatórias em produção.
MONGODB_URI=mongodb://localhost:27017/ntalk
REDIS_URL=redis://localhost:6379/0

# Nome do cookie de sessão (padrão: livetalk.id)
# SESSION_NAME=livetalk.id

# Defina como true quando estiver atrás de um proxy reverso com HTTPS (necessário para cookie "secure")
TRUST_PROXY=false

# Número de workers do cluster (padrão: número de CPUs)
# WEB_CONCURRENCY=2

# Cookie de sessão "secure" (só trafega em HTTPS). Padrão: true em produção.
# Use false APENAS para testar a imagem de produção localmente sem HTTPS.
# COOKIE_SECURE=true
