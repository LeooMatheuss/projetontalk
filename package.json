{
  "name": "livetalk",
  "description": "LiveTalk - Agenda de contatos com presença online e chat em tempo real",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node clusters.js",
    "dev": "node app.js",
    "test": "NODE_ENV=test mocha",
    "services:up": "docker compose up -d mongo redis",
    "services:down": "docker compose stop mongo redis"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "compression": "1.8.2",
    "connect-redis": "7.1.1",
    "consign": "0.1.6",
    "ejs": "3.1.10",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "method-override": "3.0.0",
    "mongoose": "8.24.5",
    "redis": "4.7.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "mocha": "12.0.2",
    "should": "13.2.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2"
  }
}
